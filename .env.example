# Copy to .env and fill in. Never commit a real .env file: it is gitignored.

# Optional: only needed for gated models or to push artifacts.
HF_TOKEN=

# Optional experiment tracking.
WANDB_API_KEY=
WANDB_PROJECT=pubmedqa-loraplus
WANDB_ENTITY=
WANDB_MODE=offline

# Optional base-model override.
BASE_MODEL_ID=

# Modal volume mount point used by the notebook.
PUBMEDQA_MODAL_ROOT=/vol/pubmedqa-loraplus

# Optional Hub destinations for `scripts/push_to_hub.py`.
ADAPTER_HUB_REPO_ID=
MERGED_HUB_REPO_ID=
